[Unit]
Description=Back up PP Calendar SQLite database
Wants=network-online.target
After=pp-calendar.service network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/libexec/pp-calendar-backup
User=root
Group=root
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/data/pp-calendar /srv/backups/pp-calendar /srv/data/aliyunpan/config /srv/data/aliyunpan/uploads
UMask=0077
